{
  "id": "borgeet-001",
  "title": "শুন শুন ৰে সুৰবৈৰী প্ৰমাণা",
  "author": "শ্ৰীমন্ত শংকৰদেৱ",
  "language": "Old Assamese",
  "stanzas": [
    {
      "title": "ধ্ৰুং",
      "lines": [
        {
          "text": "শুন শুন ৰে সুৰবৈৰী প্ৰমাণা",
          "words": [
            {
              "word": "সুৰবৈৰী",
              "assamese": "দেৱতাসকলৰ শত্ৰু (ৰাৱণ)",
              "english": "Enemy of the gods (Ravana)",
              "root": [
                {
                  "word": "সুৰ",
                  "meaning": "দেৱতা"
                },
                {
                  "word": "বৈৰী",
                  "meaning": "শত্ৰু"
                }
              ]
            },
            {
              "word": "প্ৰমাণা",
              "assamese": "মহান, শক্তিশালী",
              "english": "Mighty"
            }
          ]
        },
        {
          "text": "নিশাচৰ নাশনিদানা",
          "words": [
            {
              "word": "নিশাচৰ",
              "assamese": "ৰাতি বিচৰণ কৰা ৰাক্ষস",
              "english": "Night-roaming demon"
            },
            {
              "word": "নাশনিদানা",
              "assamese": "বিনাশপ্ৰাপ্ত হ'বলগীয়া",
              "english": "Doomed to destruction"
            }
          ]
        },
        {
          "text": "ৰামনাম যম সমৰক সাজি",
          "words": [
            {
              "word": "সমৰ",
              "assamese": "যুদ্ধ",
              "english": "Battle"
            }
          ]
        },
        {
          "text": "সমদলে কয়লি পয়াণা",
          "words": [
            {
              "word": "সমদলে",
              "assamese": "সম্পূৰ্ণ সেনাবাহিনীৰ সৈতে",
              "english": "With the whole army"
            },
            {
              "word": "পয়াণা",
              "assamese": "যাত্ৰা কৰিলে",
              "english": "Set out"
            }
          ]
        }
      ],
      "meaning": {
        "assamese": "ৰামে সমগ্ৰ সেনাবাহিনীৰ সৈতে ৰাৱণৰ বিৰুদ্ধে যুদ্ধলৈ আগবাঢ়িছে।",
        "english": "Rama marches with his entire army against Ravana."
      }
    },
    {
      "title": "পদ ১",
      "lines": [
        {
          "text": "ঠাট প্রকট পটু কোটি কোটি কপি",
          "words": [
            {
              "word": "কপি",
              "assamese": "বানৰ",
              "english": "Monkey"
            }
          ]
        },
        {
          "text": "গিৰি গৰ গৰ পদঘাৱে।",
          "words": [
            {
              "word": "গিৰি",
              "assamese": "পৰ্বত",
              "english": "Mountain"
            }
          ]
        },
        {
          "text": "বাৰিধি তৰি তৰি কৰে গুৰুতৰ গিৰি",
          "words": [
            {
              "word": "বাৰিধি",
              "assamese": "সাগৰ",
              "english": "Ocean"
            }
          ]
        },
        {
          "text": "ধৰি ধৰি সমৰক ধাৱে।।",
          "words": [
            {
              "word": "ধাৱে",
              "assamese": "দৌৰে",
              "english": "Rushes"
            }
          ]
        }
      ],
      "meaning": {
        "assamese": "বানৰসৈন্যই সাগৰ পাৰ হৈ যুদ্ধলৈ ধাৱমান।",
        "english": "The monkey army crosses the ocean and rushes to battle."
      }
    },
    {
      "title": "পদ ২",
      "lines": [
        {
          "text": "হাট ঘাট বহু বাট বিয়াপিএ",
          "words": [
            {
              "word": "বিয়াপিএ",
              "assamese": "বিয়পি পৰে",
              "english": "Spread everywhere"
            }
          ]
        },
        {
          "text": "চৌগড়ে বেঢ়ল লংকা।",
          "words": [
            {
              "word": "চৌগড়ে",
              "assamese": "চাৰিওফালে",
              "english": "On all sides"
            }
          ]
        },
        {
          "text": "গুৰু ঘন ঘন ঘোষ ঘৰিষণ গর্জন।",
          "words": [
            {
              "word": "ঘোষ",
              "assamese": "যুদ্ধধ্বনি",
              "english": "Battle cry"
            }
          ]
        },
        {
          "text": "শ্ৰৱণে জনময় শংকা।।",
          "words": [
            {
              "word": "শংকা",
              "assamese": "ভয়",
              "english": "Fear"
            }
          ]
        }
      ],
      "meaning": {
        "assamese": "লংকা চাৰিওফালে ঘেৰাও কৰা হৈছে।",
        "english": "Lanka is surrounded and filled with the sounds of war."
      }
    },
    {
      "title": "পদ ৩",
      "lines": [
        {
          "text": "ধীৰ বীৰ শূৰশেখৰ ৰাঘৱ",
          "words": [
            {
              "word": "শূৰশেখৰ",
              "assamese": "বীৰসকলৰ শ্ৰেষ্ঠ",
              "english": "Greatest hero"
            }
          ]
        },
        {
          "text": "ৰাৱণ তুৱাপৰি জাম্পে।",
          "words": [
            {
              "word": "জাম্পে",
              "assamese": "আক্ৰমণ কৰে",
              "english": "Leaps upon"
            }
          ]
        },
        {
          "text": "সুৰ নৰ কিন্নৰ ফণধৰ থৰ থৰ",
          "words": [
            {
              "word": "কিন্নৰ",
              "assamese": "স্বৰ্গীয় সত্তা",
              "english": "Celestial being"
            }
          ]
        },
        {
          "text": "মহীধৰ তৰসি প্রকম্পে।।",
          "words": [
            {
              "word": "মহীধৰ",
              "assamese": "পৰ্বত",
              "english": "Mountain"
            }
          ]
        }
      ],
      "meaning": {
        "assamese": "ৰামৰ বীৰত্বত সমগ্ৰ জগত কঁপি উঠে।",
        "english": "All beings tremble before Rama's heroic advance."
      }
    },
    {
      "title": "পদ ৪",
      "lines": [
        {
          "text": "অন্ধ মুগুধ দশস্কন্ধ পাপবুধ ।",
          "words": [
            {
              "word": "দশস্কন্ধ",
              "assamese": "দশমূৰীয়া ৰাৱণ",
              "english": "Ten-headed Ravana"
            }
          ]
        },
        {
          "text": "জানকী শিৰত চৰাই।",
          "words": [
            {
              "word": "জানকী",
              "assamese": "সীতা",
              "english": "Sita"
            }
          ]
        },
        {
          "text": "ৰঘুপতি পদবৰ ধৰ ৰজনীচৰ",
          "words": [
            {
              "word": "ৰঘুপতি",
              "assamese": "ভগৱান ৰাম",
              "english": "Lord Rama"
            },
            {
              "word": "ৰজনীচৰ",
              "assamese": "ৰাক্ষস",
              "english": "Demon"
            }
          ]
        },
        {
          "text": "শংকৰ কহতু উপায়।।",
          "words": [
            {
              "word": "উপায়",
              "assamese": "মুক্তিৰ পথ",
              "english": "Way of salvation"
            }
          ]
        }
      ],
      "meaning": {
        "assamese": "শংকৰদেৱে ৰাৱণক ৰামৰ শৰণ ল'বলৈ উপদেশ দিছে।",
        "english": "Sankardeva advises Ravana to surrender to Rama."
      }
    }
  ]
}